{
  "name": "aura-auth",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch index.ts",
    "start": "NODE_ENV=production bun run index.ts",
    "build": "bun build index.ts --compile --outfile dist/index.js",
    "lint": "bun lint",
    "format": "bun format",
    "gen-keys": "bun run scripts/gen-secrets.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "jose": "^6.2.2"
  }
}